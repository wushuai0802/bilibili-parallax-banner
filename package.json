{
  "name": "bilibili-parallax-banner",
  "version": "1.4.0",
  "description": "Dependency-free layered pointer-parallax banner with Bilibili-style motion, responsive layout and an asset contract.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/banner.umd.cjs",
  "module": "dist/banner.js",
  "types": "dist/banner.d.ts",
  "exports": {
    ".": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.js",
      "require": "./dist/banner.umd.cjs"
    },
    "./style.css": "./dist/banner.css",
    "./ubits": "./dist/ubits.js",
    "./ubits.css": "./dist/ubits.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "templates",
    "schemas",
    "integrations",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wushuai0802/bilibili-parallax-banner.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-assets.mjs",
    "validate:showcase": "node scripts/theme.mjs check examples/frieren/theme.json && node scripts/theme.mjs check examples/studio/theme.json && node scripts/theme.mjs check examples/ubits/theme/theme.json",
    "validate:theme": "node scripts/validate-theme.mjs",
    "theme:init": "node scripts/theme.mjs init",
    "theme:build": "node scripts/theme.mjs build",
    "theme:check": "node scripts/theme.mjs check",
    "package:ubits": "node scripts/package-ubits.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "test:browser": "playwright test",
    "showcase:gif": "node scripts/render-showcase.mjs",
    "showcase:composition": "node scripts/render-composition.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "npm run build && npm test && npm run validate && npm run validate:showcase && npm run validate:theme"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "sharp": "0.35.5"
  }
}
