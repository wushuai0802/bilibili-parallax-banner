{
  "version": 1,
  "name": "new-theme-template",
  "artwork": {
    "author": "Bilibili Parallax Banner contributors",
    "source": "Original geometric placeholders in this template",
    "license": "MIT"
  },
  "breakpoint": 767,
  "minimumMargin": 4,
  "variants": {
    "desktop": {
      "manifest": "desktop/banner.json",
      "viewports": [768, 1024, 1280, 1440, 1920, 2560, 3440, 5120],
