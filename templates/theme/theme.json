        {"id": "subject-head", "layerId": "subject", "rect": [1170, 25, 140, 130]}
      ],
      "textZones": [
        {"id": "site-title", "rect": [0.04, 0.45, 0.3, 0.5]}
      ]
    },
    "mobile": {
      "manifest": "mobile/banner.json",
      "viewports": [280, 320, 360, 375, 390, 412, 430, 600, 767],
      "protectedRegions": [
        {"id": "subject-head", "layerId": "subject", "rect": [226, 88, 72, 75]}
      ],
      "textZones": [
        {"id": "site-title", "rect": [0.048, 0.05, 0.6, 0.32]}
      ]
    }
  }
}
